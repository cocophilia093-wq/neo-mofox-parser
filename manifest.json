            "component_name": "开启解析",
            "dependencies": [],
            "enabled": true
        },
        {
            "component_type": "command",
            "component_name": "关闭解析",
            "dependencies": [],
            "enabled": true
        },
        {
            "component_type": "command",
            "component_name": "登录B站",
            "dependencies": [],
            "enabled": true
        }
    ],
    "entry_point": "plugin.py",
    "min_core_version": "1.0.0",
    "python_dependencies": [
        "aiohttp",
        "aiofiles",
        "yt-dlp",
        "msgspec",
        "tqdm",
        "apscheduler",
        "bilibili-api-python",
        "curl_cffi",
        "Pillow",
        "apilmoji"
