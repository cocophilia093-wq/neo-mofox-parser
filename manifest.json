    "tags": ["parser", "bilibili", "douyin", "weibo", "xhs", "zhihu", "tiktok", "twitter", "youtube", "instagram", "link-parser"],
    "dependencies": {
        "plugins": [],
        "components": []
    },
    "include": [
        {
            "component_type": "event_handler",
            "component_name": "parser_message",
            "dependencies": [],
            "enabled": true
        },
        {
